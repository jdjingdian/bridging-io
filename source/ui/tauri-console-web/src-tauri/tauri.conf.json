{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BridgingIO Desktop Console",
  "version": "0.1.0",
  "identifier": "io.bridging.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bash ./src-tauri/scripts/sync-web-assets.sh",
    "beforeBuildCommand": "bash ./src-tauri/scripts/sync-web-assets.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BridgingIO Desktop Console",
        "url": "index.html",
        "width": 1400,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/bridgingio-core"
    ]
  }
}
